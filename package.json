{
  "name": "cotrasoft-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "biome format --write ./src astro.config.mjs",
    "lint": "biome check --write ./src astro.config.mjs",
    "cf:preview": "wrangler dev",
    "cf:prod": "wrangler deploy",
    "cf:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.124.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "vitest": "^5.0.0"
  }
}
