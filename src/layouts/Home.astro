---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import OgHome from "../assets/og-image.png";
import BaseHead from "../components/BaseHead.astro";
import Benefits from "../components/Benefits.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Navbar from "../components/Navbar.astro";
import Services from "../components/Services.astro";
import OrganizationJsonLd from "../components/seo/OrganizationJsonLd.astro";
import ServicesJsonLd from "../components/seo/ServicesJsonLd.astro";
import WebsiteJsonLd from "../components/seo/WebsiteJsonLd.astro";
import {
  DEFAULT_LOCALE,
  ENTITY_DESCRIPTION,
  HREFLANG,
  resolveLocale,
  SITE_TITLE,
  SUPPORTED_LOCALES,
  type SupportedLang,
  X_DEFAULT,
} from "../consts";
import { type ServicesContent, servicesContent } from "../lib/services";

const lang = resolveLocale(Astro.currentLocale);

// Single resolution point for the visible cards and the JSON-LD below:
// both derive from `servicesData`, so a `content` override applied here
// cannot drift between markup and structured data.
const servicesData: ServicesContent = servicesContent[lang];
const homeServices: Array<{ name: string; description: string }> = [
  servicesData.rescue,
  servicesData.accelerated,
  servicesData.consulting,
].map(({ title, description }) => ({ name: title, description }));

interface HreflangAlternate {
  hreflang: string;
  href: string | URL;
}

const alternates: HreflangAlternate[] = [
  ...SUPPORTED_LOCALES.map(
    (code: SupportedLang): HreflangAlternate => ({
      hreflang: HREFLANG[code],
      href: getAbsoluteLocaleUrl(code, "/"),
    }),
  ),
  {
    hreflang: X_DEFAULT,
    href: getAbsoluteLocaleUrl(DEFAULT_LOCALE, "/"),
  },
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={ENTITY_DESCRIPTION[lang]}
			lang={lang}
			image={OgHome}
			imageAlt="Cotrasoft"
			alternates={alternates}
		/>
		<OrganizationJsonLd description={ENTITY_DESCRIPTION[lang]} />
		<WebsiteJsonLd lang={lang} />
		<ServicesJsonLd services={homeServices} />
	</head>
	<body>
		<Navbar />
		<main>
			<Hero />
			<Services content={servicesData} />
			<Benefits />
		</main>
		<Footer />

		<!-- Reveal-on-scroll animation: adds `is-visible` when a `.reveal` element enters the viewport, so it can fade in. -->
		<script>
			const observer = new IntersectionObserver(
				(entries, obs) => {
					entries
						.filter((entry) => entry.isIntersecting)
						.forEach((entry) => {
							entry.target.classList.add("is-visible");
							obs.unobserve(entry.target);
						});
				},
				{ threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
			);
			document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
		</script>
	</body>
</html>
