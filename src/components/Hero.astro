---
import {
  ENTITY_DESCRIPTION,
  resolveLocale,
  type SupportedLang,
} from "../consts";

interface HeroLabels {
  heading: string;
  subheading: string;
  ctaPrimary: string;
  ctaSecondary: string;
}

interface Props {
  labels?: Partial<HeroLabels>;
}

const { labels = {} } = Astro.props;

const lang = resolveLocale(Astro.currentLocale);

const defaults: Record<SupportedLang, HeroLabels> = {
  es: {
    heading: "Software senior potenciado por IA, hecho en cooperativa",
    subheading: ENTITY_DESCRIPTION.es,
    ctaPrimary: "Explora nuestros servicios",
    ctaSecondary: "Únete a la cooperativa",
  },
  en: {
    heading: "Senior AI-powered software, built as a cooperative",
    subheading: ENTITY_DESCRIPTION.en,
    ctaPrimary: "Explore our services",
    ctaSecondary: "Join the cooperative",
  },
};

const t: HeroLabels = { ...defaults[lang], ...labels };

const servicesHref = "#servicios";
const cooperativeHref = "#beneficios";
---

<section
	id="hero"
	aria-labelledby="hero-heading"
	class="relative min-h-screen flex items-center justify-center overflow-hidden py-24 bg-linear-to-br from-primary-950 via-primary-800 to-primary-600"
>
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute top-1/4 left-1/4 text-white/30 animate-float">
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-12 sm:size-16"
				aria-hidden="true"
			>
				<polyline points="16 18 22 12 16 6" />
				<polyline points="8 6 2 12 8 18" />
			</svg>
		</div>
		<div
			class="absolute top-1/4 right-1/4 text-white/30 animate-float"
			style="animation-delay: -2s"
		>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-12 sm:size-16"
				aria-hidden="true"
			>
				<ellipse cx="12" cy="5" rx="9" ry="3" />
				<path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
				<path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
			</svg>
		</div>
		<div
			class="absolute bottom-1/4 left-1/3 text-white/30 animate-float"
			style="animation-delay: -4s"
		>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-12 sm:size-16"
				aria-hidden="true"
			>
				<rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
				<line x1="3" y1="9" x2="21" y2="9" />
				<line x1="9" y1="21" x2="9" y2="9" />
			</svg>
		</div>
	</div>

	<div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
		<h1
			id="hero-heading"
			class="mb-6 text-4xl sm:text-6xl lg:text-7xl font-bold text-white animate-fade-up"
		>
			{t.heading}
		</h1>
		<p
			class="mx-auto mb-8 max-w-3xl text-xl sm:text-2xl text-white/90 animate-fade-up"
			style="animation-delay: 100ms"
		>
			{t.subheading}
		</p>
		<div
			class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up"
			style="animation-delay: 200ms"
		>
			<a
				href={servicesHref}
				class="inline-block rounded-full bg-white px-8 py-4 text-lg sm:text-xl font-semibold text-primary-800 shadow-lg transition-all duration-300 hover:bg-primary-50 hover:shadow-xl"
			>
				{t.ctaPrimary}
			</a>
			<a
				href={cooperativeHref}
				class="inline-block rounded-full border-2 border-white px-8 py-4 text-lg sm:text-xl font-semibold text-white transition-all duration-300 hover:bg-white/10"
			>
				{t.ctaSecondary}
			</a>
		</div>
	</div>
</section>
