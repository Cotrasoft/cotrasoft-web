---
import { DEFAULT_LOCALE, type SupportedLang } from "../consts";
import {
  type Service,
  type ServicesContent,
  servicesContent,
} from "../lib/services";
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

interface Props {
  content?: Partial<ServicesContent>;
}

const { content = {} } = Astro.props;
const lang = (Astro.currentLocale ?? DEFAULT_LOCALE) as SupportedLang;

const t: ServicesContent = { ...servicesContent[lang], ...content };

const services: Array<{ icon: IconName; service: Service }> = [
  { icon: "life-buoy", service: t.rescue },
  { icon: "zap", service: t.accelerated },
  { icon: "compass", service: t.consulting },
];

const phases = t.process.phases.map((phase, i) => ({
  step: String(i + 1).padStart(2, "0"),
  ...phase,
}));

const ctaHref = "https://app.cotrasoft.co/registro";
---

<section
	id="servicios"
	aria-labelledby="services-heading"
	class="section-padding bg-gray-50 dark:bg-gray-800"
>
	<div class="mx-auto max-w-7xl">
		<div class="reveal mb-16 text-center">
			<h2
				id="services-heading"
				class="mb-4 text-3xl sm:text-4xl font-bold gradient-text"
			>
				{t.heading}
			</h2>
			<p class="mx-auto max-w-3xl text-xl text-gray-600 dark:text-gray-300">
				{t.subheading}
			</p>
		</div>

		<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
			{
				services.map(({ icon, service }, index) => (
					<article
						class="reveal rounded-xl bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:bg-gray-700/50"
						style={`--reveal-delay: ${index * 100}ms`}
					>
						<div class="mb-4 flex items-center">
							<div class="flex size-12 items-center justify-center rounded-full bg-primary-100 text-primary-700">
								<Icon name={icon} class="size-6" />
							</div>
							<h3 class="ml-4 text-xl font-semibold dark:text-white">
								{service.title}
							</h3>
						</div>
						<p class="mb-4 text-gray-600 dark:text-gray-300">
							{service.description}
						</p>
						<ul class="space-y-2">
							{service.deliverables.map((item) => (
								<li class="flex items-start space-x-2">
									<Icon
										name="check"
										class="mt-0.5 size-5 shrink-0 text-primary"
									/>
									<span class="text-sm text-gray-600 dark:text-gray-300">
										{item}
									</span>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>

		<div class="reveal mt-20">
			<div class="mb-12 text-center">
				<h3 class="mb-3 text-2xl sm:text-3xl font-bold gradient-text">
					{t.process.heading}
				</h3>
				<p class="mx-auto max-w-2xl text-lg text-gray-600 dark:text-gray-300">
					{t.process.subheading}
				</p>
			</div>

			<ol class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{
					phases.map((phase, index) => (
						<li
							class="reveal relative rounded-xl bg-white p-6 dark:bg-gray-700/50"
							style={`--reveal-delay: ${index * 100}ms`}
						>
							<span class="text-5xl font-bold text-primary-200 dark:text-primary-800">
								{phase.step}
							</span>
							<h4 class="mt-2 mb-1 text-lg font-semibold dark:text-white">
								{phase.title}
							</h4>
							<span class="mb-3 inline-block rounded-full bg-primary-50 px-2 py-1 text-xs font-medium text-primary">
								{phase.days}
							</span>
							<p class="text-sm text-gray-600 dark:text-gray-300">
								{phase.description}
							</p>
						</li>
					))
				}
			</ol>
		</div>

		<div class="reveal mt-16 text-center">
			<a href={ctaHref} class="btn-primary inline-flex items-center space-x-2">
				<span>{t.cta}</span>
				<Icon name="arrow-right" class="size-5" />
			</a>
		</div>
	</div>
</section>
