---
import { DEFAULT_LOCALE, type SupportedLang } from "../../consts";
import { organizationId } from "../../lib/jsonld";
import { siteUrl } from "../../lib/site";

interface Props {
  lang?: SupportedLang;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

const siteURL = siteUrl(Astro.site);
const data = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Cotrasoft",
  url: siteURL.href,
  inLanguage: lang,
  publisher: { "@id": organizationId(siteURL) },
};
---

<script
	type="application/ld+json"
	is:inline
	set:html={JSON.stringify(data).replaceAll("<", "\\u003c")}
/>
