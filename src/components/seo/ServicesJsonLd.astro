---
import { organizationId } from "../../lib/jsonld";
import { siteUrl } from "../../lib/site";

interface Service {
  name: string;
  description: string;
}

interface Props {
  services: Service[];
}

const { services } = Astro.props;

const siteURL = siteUrl(Astro.site);

const data = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: services.map((svc, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Service",
      name: svc.name,
      description: svc.description,
      provider: { "@id": organizationId(siteURL) },
    },
  })),
};
---

<script
	type="application/ld+json"
	is:inline
	set:html={JSON.stringify(data).replaceAll("<", "\\u003c")}
/>
