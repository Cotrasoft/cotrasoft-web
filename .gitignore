# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/


# CF workers
.wrangler/

# Claude Code: per-user overrides, not shared with the team.
# The rest of .claude/ (CLAUDE.md, rules/, skills/) is shared on purpose.
.claude/settings.local.json

# Skill evaluation output — regenerable, and hundreds of KB of generated reports.
# The harness stays tracked (evals/, grade.py, run_grading.py) so a run can be
# reproduced; only its results are ignored.
.claude/*-evals/iteration-*/

# Python bytecode from the skill scripts
__pycache__/
*.pyc
